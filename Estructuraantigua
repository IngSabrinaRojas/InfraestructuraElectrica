    LANGUAGE plpgsql
    AS $$
BEGIN
    -- Actualizar la cantidad de transformadores en caracterizacion_sub
    UPDATE public.caracterizacion_sub
    SET cantidadtrx_csub = (
        SELECT COUNT(*)
        FROM public.caracterizacion_trans
        WHERE key_sub = NEW.key_sub
    )
