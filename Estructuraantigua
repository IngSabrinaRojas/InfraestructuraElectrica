    LANGUAGE plpgsql
    AS $$
BEGIN
    -- Calcular la sumatoria de onaf_ctrans de los transformadores vinculados a la subestación
    UPDATE public.caracterizacion_sub
    SET totalmva_csub = (
        SELECT COALESCE(SUM(onaf_ctrans), 0)
        FROM public.caracterizacion_trans
        WHERE key_sub = NEW.key_sub
    )
    WHERE key_sub = NEW.key_sub;

    RETURN NEW;
END;
$$;


